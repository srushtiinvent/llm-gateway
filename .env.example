

MOCK_PROVIDERS=true

# A password for the admin endpoints (create keys, see the dashboard numbers).
# Choose your own. Locally "dev-admin-token" is fine; on a real server use a long random value.
ADMIN_TOKEN=dev-admin-token

PORT=8080

# ---------------------------------------------------------------
# 2. USE REAL AI PROVIDERS (free keys)
#    Set MOCK_PROVIDERS=false, then add at least one key below.
#    Gemini : https://aistudio.google.com/apikey
#    Groq   : https://console.groq.com/keys
#    OpenRouter (optional): https://openrouter.ai/keys
# ---------------------------------------------------------------
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Order the gateway tries providers in (providers without a key are skipped):
# PROVIDER_ORDER=gemini,groq,openrouter

# Model names and free-tier limits change often. Check each provider's website and edit if needed:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_RPM=10
# GEMINI_RPD=250
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_RPM=30
# GROQ_RPD=1000
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_RPM=20
# OPENROUTER_RPD=50

# ---------------------------------------------------------------
# 3. DATABASE (optional)
#    Without it, keys and logs live in memory and vanish when you stop the gateway.
#    With a free Neon database they are kept. Paste the connection string here:
# ---------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------
# 4. TUNING (all optional)
# ---------------------------------------------------------------
# MAX_CONCURRENT=8          # requests being processed at the same time
# QUEUE_MAX_WAITING=50      # requests allowed to wait in line before we say "busy"
# QUEUE_WAIT_TIMEOUT=20s
# ATTEMPT_TIMEOUT=25s       # time limit for one call to a provider
# MAX_RETRIES=1             # extra tries on the same provider after a temporary failure
# BREAKER_THRESHOLD=3       # failures in a row before a provider is paused
# BREAKER_OPEN_FOR=30s      # how long a paused provider rests
# CACHE_TTL=1h
# CACHE_MAX_ENTRIES=1000
# DEFAULT_KEY_RPM=20        # default per-key limit for new keys (requests per minute)
# DEFAULT_KEY_DAILY=500     # default per-key limit (provider calls per day)
# LOG_RETENTION_DAYS=14
# LOG_LEVEL=info            # or debug

# For load tests with the fake providers (0 = unlimited):
# MOCK_RPM=0
# MOCK_RPD=0
# MOCK_LATENCY_MS=5

# ---------------------------------------------------------------
# 4. PUBLIC WEBSITE (so anyone can try it without the admin token)
#    The site gives every visitor their own small free key (POST /v1/signup).
#    These limits protect your free-tier quota. Tune them to taste.
# ---------------------------------------------------------------
# PUBLIC_SIGNUP=true          # false = nobody can self-create keys
# PUBLIC_KEY_RPM=6            # requests per minute for a visitor key
# PUBLIC_KEY_DAILY=20         # provider calls per day for a visitor key
# SIGNUP_PER_IP_PER_DAY=3     # free keys one address can create per day
# SIGNUP_GLOBAL_PER_DAY=200   # free keys the whole site hands out per day
# BYOK_RPM=30                # requests/minute when a visitor uses their own provider keys
# TRUSTED_PROXY_HOPS=1        # reverse proxies in front (Render = 1; local = 0)
# WEB_DIST=web/dist           # serve the website from this Go server (run: cd web && npm ci && npm run build)
